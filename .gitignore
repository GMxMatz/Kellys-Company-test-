# Dependency folders (keeps your repo lightweight)
node_modules/
bower_components/

# Environment secrets (CRITICAL: prevents leaking passwords, API keys, or tokens)
.env
.env.local
.env.*.local

# Build outputs (files created when you bundle your website)
dist/
build/
.next/
.nuxt/
# Operating System & IDE junk files
.DS_Store
Thumbs.db
.vscode/
.idea/
